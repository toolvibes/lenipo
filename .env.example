# Copy to .env and adjust. Defaults match docker-compose.yml.
NODE_ENV=development
LOG_LEVEL=info

# api | collab | worker | all
MODE=all
API_PORT=4000
COLLAB_PORT=4001

DATABASE_URL=postgres://tasklore:tasklore@localhost:5440/tasklore
REDIS_URL=redis://localhost:6380

# Public address used in log messages and links (dev: the Vite server).
PUBLIC_URL=http://localhost:5173

# OpenID Connect sign-in. For the local Keycloak (dev/keycloak/README.md) uncomment:
# OIDC_ISSUER_URL=http://localhost:8180/realms/tasklore
# OIDC_CLIENT_ID=tasklore
# OIDC_CLIENT_SECRET=tasklore-dev-secret
# OIDC_DISPLAY_NAME=Keycloak (Entwicklung)
# OIDC_GROUPS_CLAIM=groups

# Attachments: local directory (default) or S3-compatible storage.
# STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=./data/files
# For the RustFS from docker-compose.yml:
# STORAGE_DRIVER=s3
# S3_ENDPOINT=http://localhost:9010
# S3_BUCKET=tasklore
# S3_ACCESS_KEY_ID=tasklore
# S3_SECRET_ACCESS_KEY=tasklore-dev-secret
# ATTACHMENT_MAX_MB=25

# Outgoing email for notifications; Mailpit from docker-compose.yml shows them at http://localhost:8026
SMTP_URL=smtp://localhost:1026
MAIL_FROM=Tasklore <tasklore@localhost>
# Seconds without further changes before a bundled notification email goes out (default 120)
# NOTIFICATION_EMAIL_DELAY_SECONDS=120

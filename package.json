{
  "name": "tasklore",
  "private": true,
  "description": "Self-hosted project tracking and knowledge base",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:generate": "pnpm --filter @tasklore/api db:generate",
    "db:migrate": "pnpm --filter @tasklore/api db:migrate",
    "licenses:check": "node scripts/check-licenses.mjs",
    "design:tokens": "node scripts/build-design-tokens.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  }
}

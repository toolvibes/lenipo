# Copy to .env next to docker-compose.yml and adjust; `docker compose up -d` reads it.
# Empty values keep Lenipo's defaults.

# Required: password of the bundled PostgreSQL, e.g. from `openssl rand -hex 24`.
POSTGRES_PASSWORD=

# Your domain for automatic HTTPS (e.g. lenipo.example.org). Empty: plain HTTP on LENIPO_HTTP_PORT,
# for a first try on your own machine.
SITE_ADDRESS=
# Public address for links in emails, OAuth (MCP clients) and SSO, e.g. https://lenipo.example.org
PUBLIC_URL=

# Image tag: latest (proven for some days), a fixed version such as 1.2.1, or edge.
LENIPO_VERSION=latest
# Ports on the host (defaults 80 and 443), e.g. 8080 when port 80 is taken.
LENIPO_HTTP_PORT=80
LENIPO_HTTPS_PORT=443

# Outgoing email (invitations, notifications); without it no email is sent.
# SMTP_URL=smtp://user:password@mail.example.org:587
# MAIL_FROM=Lenipo <lenipo@example.org>

# Sign-in with OpenID Connect (Keycloak, Authentik, Entra ID …); needs PUBLIC_URL.
# OIDC_ISSUER_URL=https://id.example.org/realms/main
# OIDC_CLIENT_ID=lenipo
# OIDC_CLIENT_SECRET=
# OIDC_DISPLAY_NAME=Firmen-Login
# OIDC_GROUPS_CLAIM=groups

# Attachments in S3 instead of the volume app-files (with --profile s3 for the bundled RustFS).
# STORAGE_DRIVER=s3
# S3_ENDPOINT=http://rustfs:9000
# S3_BUCKET=lenipo
# S3_ACCESS_KEY_ID=lenipo
# S3_SECRET_ACCESS_KEY=

# Links for help, support, imprint and privacy policy.
# HELP_URL=
# SUPPORT_URL=
# IMPRINT_URL=
# PRIVACY_URL=

# For hosting services: set up the instance over the API (at least 32 characters).
# SETUP_TOKEN=

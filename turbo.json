{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "DATABASE_URL",
        "TEST_DATABASE_URL",
        "TEST_S3_ENDPOINT",
        "TEST_S3_ACCESS_KEY_ID",
        "TEST_S3_SECRET_ACCESS_KEY"
      ],
      "passThroughEnv": ["TEST_LOG_LEVEL"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}

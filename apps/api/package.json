{
  "name": "@toolvibes/api",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,node -c blue,green \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch --enable-source-maps --env-file-if-exists=../../.env dist/main.js\"",
    "start": "node --enable-source-maps --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env dist/db/migrate-cli.js",
    "wiki": "node --env-file-if-exists=../../.env dist/wiki/wiki-cli.js",
    "openapi:export": "node dist/openapi/export.js ../../packages/sdk/openapi.json"
  },
  "dependencies": {
    "@hocuspocus/extension-redis": "4.7.1",
    "@hocuspocus/server": "4.7.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@node-rs/argon2": "2.2.2",
    "@node-saml/node-saml": "5.1.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/instrumentation-express": "0.71.1",
    "@opentelemetry/instrumentation-http": "0.223.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@tiptap/y-tiptap": "3.0.10",
    "@toolvibes/editor": "workspace:*",
    "@toolvibes/shared": "workspace:*",
    "@toolvibes/tql": "workspace:*",
    "aws4fetch": "1.0.20",
    "busboy": "1.6.0",
    "docx": "9.12.0",
    "domhandler": "6.0.1",
    "drizzle-orm": "0.45.4",
    "fflate": "0.8.3",
    "htmlparser2": "12.0.0",
    "imapflow": "2.5.8",
    "ioredis": "5.11.1",
    "ldapts": "9.2.0",
    "mailparser": "3.10.0",
    "nestjs-pino": "5.3.1",
    "nodemailer": "10.2.1",
    "openid-client": "6.8.8",
    "pino": "10.4.0",
    "pino-http": "*",
    "postgres": "3.4.9",
    "prom-client": "15.1.3",
    "quickjs-emscripten": "0.32.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4",
    "swagger-ui-dist": "5.33.2",
    "uuid": "14.0.3",
    "yjs": "13.6.33",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@hocuspocus/provider": "4.7.1",
    "@toolvibes/cli": "workspace:*",
    "@types/busboy": "1.5.4",
    "@types/express": "*",
    "@types/ldapjs": "3.0.6",
    "@types/mailparser": "3.9.0",
    "@types/node": "24.19.2",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "5.0.5",
    "concurrently": "10.0.6",
    "drizzle-kit": "0.31.11",
    "ldapjs": "3.0.7",
    "selfsigned": "5.5.0",
    "socket.io-client": "4.8.4",
